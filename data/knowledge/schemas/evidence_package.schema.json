{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence_package.schema.json",
  "title": "Knowledge Factory V2 Evidence Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "exam",
    "subject",
    "grade",
    "topic",
    "status",
    "sources",
    "claims",
    "coverage"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "exam": {
      "type": "string",
      "enum": [
        "TYT",
        "AYT"
      ]
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "grade": {
      "type": "string",
      "minLength": 1
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "EVIDENCE_DRAFT",
        "EVIDENCE_READY"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "locations"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "locations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "locator"
              ],
              "properties": {
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "note": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "source_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "locator"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "kind": {
            "type": "string",
            "enum": [
              "objective",
              "core_concept",
              "definition",
              "rule",
              "teaching_note"
            ]
          },
          "term": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "curriculum_objectives"
      ],
      "properties": {
        "curriculum_objectives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded_terms": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}