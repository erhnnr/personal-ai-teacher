{
  "$schema": "http://json-schema.org/draft-07/schema#",

  "title": "Knowledge Unit",

  "type": "object",

  "required": [
    "id",
    "subject",
    "grade",
    "topic",
    "level",
    "concept",
    "explanation"
  ],

  "properties": {

    "id": {
      "type": "string"
    },

    "subject": {
      "type": "string"
    },

    "grade": {
      "type": "integer"
    },

    "topic": {
      "type": "string"
    },

    "level": {
      "enum": [
        "basic",
        "intermediate",
        "advanced"
      ]
    },

    "concept": {
      "type": "string"
    },

    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "explanation": {
      "type": "string"
    },

    "examples": {
      "type": "array"
    },

    "common_mistakes": {
      "type": "array"
    },

    "questions": {
      "type": "array"
    },

    "solutions": {
      "type": "array"
    }

  }

}